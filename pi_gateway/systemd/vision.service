[Unit]
Description=Car drowsiness detector (camera -> car/vision/driver)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=bum
WorkingDirectory=/home/bum/iot_term/pi_gateway
Environment=PYTHONUNBUFFERED=1
# --frozen: use uv.lock as-is (no re-resolve at boot). Run `uv sync` after each deploy.
ExecStart=/home/bum/.local/bin/uv run --frozen python -u -m drowsiness.main --calibrate --stream-port 8000 --mqtt-host localhost
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
