{
  "uid": "car-drowsiness",
  "title": "Car drowsiness detector",
  "tags": [
    "iot",
    "car"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Driver state",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-car"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-car"
          },
          "query": "from(bucket: \"car\")\n  |> range(start: -6s)\n  |> filter(fn: (r) => r._measurement == \"driver\" and r._field == \"drowsy\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r.state}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_?[Vv]alue$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "offline",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "open": {
                  "text": "OPEN",
                  "color": "green",
                  "index": 0
                },
                "closed": {
                  "text": "CLOSED",
                  "color": "yellow",
                  "index": 1
                },
                "no_face": {
                  "text": "NO FACE",
                  "color": "yellow",
                  "index": 2
                },
                "drowsy": {
                  "text": "DROWSY",
                  "color": "red",
                  "index": 3
                },
                "unknown": {
                  "text": "?",
                  "color": "#808080",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alert level",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-car"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-car"
          },
          "query": "from(bucket: \"car\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"alert\" and r._field == \"level_num\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r.level + \" · \" + r.reason}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_?[Vv]alue$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no alerts yet",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^danger.*",
                "result": {
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^warning.*",
                "result": {
                  "color": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^ok.*",
                "result": {
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
