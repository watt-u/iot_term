          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-car"
          },
          "query": "from(bucket: \"car\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"driver\" and (r._field == \"ear\" or r._field == \"thresh\"))\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "options": {
        "legend": {
