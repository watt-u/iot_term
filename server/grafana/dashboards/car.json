      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 5000,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
