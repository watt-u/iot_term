                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "mappings": [],
          "unit": "s",
          "decimals": 0,
          "displayName": "${__series.name}"
        },
        "overrides": []
      }
    },
