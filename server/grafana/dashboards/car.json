    {
      "id": 7,
      "type": "stat",
      "title": "Sources (s since last data)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-car"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-car"
          },
          "query": "from(bucket: \"car\")\n  |> range(start: -10m)\n  |> filter(fn: (r) =>\n      (r._measurement == \"motion\" and r._field == \"a_mag\") or\n      (r._measurement == \"air\" and r._field == \"light\") or\n      (r._measurement == \"cabin\" and (r._field == \"temp\" or r._field == \"distance\")) or\n      (r._measurement == \"driver\" and r._field == \"fps\"))\n  |> group(columns: [\"_measurement\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_measurement: r._measurement, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "all offline",
          "color": {
            "mode": "thresholds"
          },
