# Copy to .env (gitignored) and change the secrets: cp .env.example .env
# Used by docker compose (InfluxDB/Grafana setup) and by server.py.

# --- InfluxDB 2 ---
INFLUX_URL=http://localhost:8086
INFLUX_ORG=iot
INFLUX_BUCKET=car
# Admin token, created on InfluxDB's first start. Generate one with: openssl rand -hex 32
INFLUX_TOKEN=change-me-to-a-long-random-token
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-please
INFLUX_RETENTION=30d

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS=true

# --- MQTT (server.py) ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- AI caption (server.py) ---
# gemini | anthropic | openai   (leave AI_API_KEY empty to disable: captions become "unavailable")
AI_PROVIDER=gemini
AI_API_KEY=
# Empty = provider default (gemini: gemini-2.5-flash, anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
AI_MODEL=
AI_TIMEOUT=20
